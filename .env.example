# Copy this file to .env and fill in your API keys.
# Do NOT commit .env or paste keys into source code.

# ── Optional address-search enhancement ────────────────────────────────
# Free tier available at https://www.geoapify.com
GEOAPIFY_API_KEY=

# ── Optional Gemini image analysis for the combined site review ─────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Optional overrides ───────────────────────────────────────────────────
# Country code for geocoding filter (ISO 3166-1 alpha-2). Default: in (India)
CIVICLENS_COUNTRY_CODE=in

# Gemini model to use for satellite analysis. Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Server host/port. Defaults: 127.0.0.1 and 8000
# CIVICLENS_HOST=127.0.0.1
# CIVICLENS_PORT=8000
